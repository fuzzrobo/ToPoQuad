<gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">
    <update_rate>400.0</update_rate>
    <always_on>true</always_on>
    <visualize>false</visualize>
    <imu>
      <angular_velocity>
        <noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.0001</stddev>
        </noise>
      </angular_velocity>
      <linear_acceleration>
        <noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </linear_acceleration>
    </imu>
  </sensor>
</gazebo>

</robot>
