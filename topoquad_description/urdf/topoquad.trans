<?xml version="1.0" ?>
<robot name="topoquad" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="BR_hip_yaw_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="BR_hip_yaw">
    <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
  </joint>
  <actuator name="BR_hip_yaw_actr">
    <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

